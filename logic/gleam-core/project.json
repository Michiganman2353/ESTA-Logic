{
  "name": "@esta-logic/gleam-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "logic/gleam-core/src",
  "projectType": "library",
  "tags": ["scope:kernel", "type:library", "lang:gleam"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "command -v gleam >/dev/null 2>&1 && (gleam deps download && gleam build --target=javascript) || echo 'Gleam not installed - skipping build'",
        "cwd": "logic/gleam-core"
      },
      "outputs": ["{projectRoot}/build"],
      "inputs": ["{projectRoot}/src/**/*.gleam", "{projectRoot}/gleam.toml"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "command -v gleam >/dev/null 2>&1 && bash scripts/gleam-test.sh logic/gleam-core || echo 'Gleam not installed - skipping tests'",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*.gleam",
        "{projectRoot}/test/**/*.gleam",
        "{projectRoot}/gleam.toml"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Gleam lint handled by compiler'",
        "cwd": "logic/gleam-core"
      },
      "inputs": [
        "{projectRoot}/src/**/*.gleam",
        "{projectRoot}/test/**/*.gleam"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf build",
        "cwd": "logic/gleam-core"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "command -v gleam >/dev/null 2>&1 && (gleam deps download && gleam build) || echo 'Gleam not installed - skipping typecheck'",
        "cwd": "logic/gleam-core"
      },
      "inputs": ["{projectRoot}/src/**/*.gleam", "{projectRoot}/gleam.toml"]
    }
  }
}
